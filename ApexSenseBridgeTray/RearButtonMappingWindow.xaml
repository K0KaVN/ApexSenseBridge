<Window x:Class="ApexSenseBridgeTray.RearButtonMappingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rear Buttons" Height="640" Width="560"
        WindowStartupLocation="CenterOwner" WindowStyle="None"
        ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/ApexSenseBridgeTray;component/Themes/ConsoleTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="RearRow" TargetType="Border" BasedOn="{StaticResource SettingRow}">
                <Setter Property="Height" Value="64"/>
                <Setter Property="CornerRadius" Value="16"/>
                <Setter Property="Padding" Value="14,0,14,0"/>
                <Setter Property="Margin" Value="0,0,0,12"/>
            </Style>
            <Style x:Key="RearButtonName" TargetType="TextBlock">
                <Setter Property="FontSize" Value="16"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
            <Style x:Key="RearButtonStatus" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Foreground" Value="#7F8DAD"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Margin" Value="0,2,0,0"/>
            </Style>
            <!-- Same dark dropdown as the executable pickers in the console theme. -->
            <Style x:Key="RearActionCombo" TargetType="ComboBox" BasedOn="{StaticResource ExecutableCombo}">
                <Setter Property="Width" Value="170"/>
                <Setter Property="Height" Value="36"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="FontSize" Value="13"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Border Style="{StaticResource ConsoleWindowFrame}" MouseLeftButtonDown="OnWindowDrag">
        <Grid Margin="26,22,26,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <DockPanel Margin="0,0,0,8">
                <Button DockPanel.Dock="Right" Content="&#x2715;" Style="{StaticResource WindowCloseBtn}" Click="OnCloseClick" VerticalAlignment="Top"/>
                <Border Style="{StaticResource IconBubble}" Width="40" Height="40" CornerRadius="20" Margin="0,0,14,0" Background="#331E6FE8">
                    <Ellipse Width="16" Height="16" Stroke="#FFFFFF" StrokeThickness="2"/>
                </Border>
                <TextBlock Text="Rear Buttons" FontSize="19" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
            </DockPanel>

            <TextBlock x:Name="TxtInstructions" Grid.Row="1" TextWrapping="Wrap" FontSize="13"
                       Foreground="#AEB9D3" Margin="0,0,0,18"
                       Text="Press each rear button once. Its row lights up when the controller reports it. Then choose what it should do."/>

            <ScrollViewer x:Name="ScrollRearButtons" Grid.Row="2" VerticalScrollBarVisibility="Auto" Focusable="False" Margin="-8,-8,-8,0">
                <StackPanel x:Name="PnlRearButtons" Margin="8"/>
            </ScrollViewer>

            <Grid Grid.Row="3" Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TxtRearStatus" VerticalAlignment="Center" Foreground="#AEB9D3" FontSize="12" TextWrapping="Wrap"/>
                <Button x:Name="BtnSaveRearBindings" Grid.Column="1" Content="Save" Padding="22,8"
                        Background="{DynamicResource PlayStationBlue}" Foreground="White"
                        BorderThickness="0" FontSize="14" FontWeight="SemiBold" Cursor="Hand"
                        Click="OnSaveRearBindingsClick"/>
            </Grid>
        </Grid>
    </Border>
</Window>